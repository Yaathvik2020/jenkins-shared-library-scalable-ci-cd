@Library('shared-lib') _

pipeline {
    agent any
    stages {

        stage('Payment Service') {
            steps {
                dir('payment-service') { // it is make the diractory
                    //git branch: 'main', url: 'https://github.com/Yaathvik2020/payment-service.git'
                    git branch: 'main', url: 'https://github.com/Yaathvik2020/DevOps-Practice-branch.git'
                    sh 'ls -ltr'
                    //sh 'npm install'
                    //sh 'npm test'
                   //dockerBuildPush(imageName: '', tag: env.BUILD_NUMBER, dockerhubUser: 'yaathvik20')
                    microservicePipeline(appName: 'payment-service', lang: 'node', dockerhubUser: 'yaathvik20')
                }
            }
        }

        stage('Inventory Service') {
            steps {
                dir('inventory-service') {
                    //git branch: 'main', url: 'https://github.com/Yaathvik2020/inventory-service.git'
                    git branch: 'main', url: 'https://github.com/Yaathvik2020/DevOps-Practice-branch.git'
                    sh 'ls -ltr'
                    //sh 'mvn clean test'
                    //dockerBuildPush(imageName: 'inventory-service', tag: env.BUILD_NUMBER, dockerhubUser: 'yaathvik20')
                   microservicePipeline(appName: 'inventory-service', lang: 'java', dockerhubUser: 'yaathvik20')
                }
            }
        }

        stage('Notification Service') {
            steps {
                dir('notification-service') {
                    //git branch: 'main', url: 'https://github.com/Yaathvik2020/notification-service.git'
                    git branch: 'main', url: 'https://github.com/Yaathvik2020/DevOps-Practice-branch.git'
                    sh 'ls -ltr'
                    //dockerBuildPush(imageName: 'notification-service', tag: env.BUILD_NUMBER, dockerhubUser: 'yaathvik20')
                    microservicePipeline(appName: 'inventory-service', lang: 'python', dockerhubUser: 'yaathvik20')
                }
            }
        }

    }
    post {
        always {
        cleanWs()
        }
        success {
            echo 'All services built and pushed successfully'
        }
        failure {
            echo 'Build failed'
        }
    }
}
